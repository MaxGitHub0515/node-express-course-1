# ── Copy this to .env.local in backend/ for local dev ─────────────────────────
# ── On Render: paste each key into Environment Variables panel ─────────────────

# ── MongoDB ────────────────────────────────────────────────────────────────────
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/ecommerce

# ── JWT ────────────────────────────────────────────────────────────────────────
ACCESS_TOKEN_SECRET=<random_32+_char_string>
REFRESH_TOKEN_SECRET=<random_32+_char_string>

# ── Upstash Redis (HTTP client — @upstash/redis) ───────────────────────────────
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=<upstash_token>

# ── Stripe ─────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...

# ── Cloudinary ─────────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=<your_cloud_name>
CLOUDINARY_API_KEY=<your_api_key>
CLOUDINARY_API_SECRET=<your_api_secret>

# ── App ────────────────────────────────────────────────────────────────────────
PORT=5001
NODE_ENV=production
ADMIN_ROLE=admin

# CLIENT_URL only needed if you add CORS — not required for single-container deploy
# CLIENT_URL=https://your-app.onrender.com

# ── Frontend (.env in frontend/ — Vite build-time only) ───────────────────────
# VITE_STRIPE_PUBLISHABLE_KEY=pk_live_...
