{
  "name": "13-chat-app",
  "version": "1.0.0", 
  "main": "backend/server.js",
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "clean": "turbo run clean",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",

    "start": "node server.js",
    "dev": "nodemon server.js",
    "lint": "eslint ."
  },
  "keywords": [
    "chat-app",
    "REST API",
    "MERN",
    "nodejs",
    "express",
    "mongodb",
    "mongoose",
    "backend"
